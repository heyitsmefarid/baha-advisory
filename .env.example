# =============================================================================
# Bahadvisory configuration
# Copy to `.env` (never commit it). Only VITE_* values reach the browser;
# everything else is read by the backend (server/) only.
# See docs/SETUP.md for where each value comes from.
# =============================================================================

# ---- Firebase web app (public, browser) ------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate key pair (Firebase Console → Project settings →
# Cloud Messaging → Web configuration). Enables background push alerts.
VITE_FIREBASE_VAPID_KEY=

# Run the web app against the local Emulator Suite (npm run dev:emulators).
# When true the Firebase keys above may stay empty.
VITE_USE_EMULATORS=false
# VITE_EMULATOR_HOST=127.0.0.1

# Default map center used when the visitor denies/lacks geolocation.
VITE_DEFAULT_CENTER_LAT=13.05
VITE_DEFAULT_CENTER_LNG=121.35
VITE_DEFAULT_ZOOM=9

# Backend base URL as seen from the browser (default: same origin /api).
# VITE_API_BASE=https://your-site.netlify.app/api

# ---- Backend: Firebase Admin (secret) ------------------------------------------
# Service-account JSON (raw or base64). Firebase Console → Project settings →
# Service accounts → Generate new private key. NEVER commit it.
FIREBASE_SERVICE_ACCOUNT=
# …or the three separate fields instead of the JSON:
FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Local emulator (set automatically by `npm run dev` when VITE_USE_EMULATORS=true
# is combined with these):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Public URL of the web app (checkout success/cancel redirects).
APP_BASE_URL=http://localhost:5173
# Extra origins allowed to call the API cross-origin (comma separated).
ALLOWED_ORIGINS=

# ---- AI (secret; free tiers first) -------------------------------------------------
# Groq — fast text tasks (chatbot, advisories, summaries, route explanations).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Google Gemini — multimodal (flood photo analysis). Check current model IDs in
# Google AI Studio; free-tier limits vary by model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Per-request timeout for AI providers (ms).
AI_TIMEOUT_MS=20000

# ---- Routing (optional) -------------------------------------------------------------
# OpenRouteService key enables native flood-polygon avoidance + truck profile.
# Without it, public OSRM servers are used with Bahadvisory's own detour search.
ORS_API_KEY=
OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car
OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike

# ---- Image storage (secret) ----------------------------------------------------------
# Cloudinary free tier (Firebase Storage needs the Blaze plan). Without these,
# report photos are stored as compressed inline images (demo fallback).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bahadvisory

# ---- Payments (secret) ---------------------------------------------------------------
# Provider used for real checkouts: paymongo | xendit | demo
PAYMENT_PROVIDER=demo
# Sandbox/demo checkout (no money moves; records flagged isDemo).
PAYMENTS_DEMO_ENABLED=true
# PayMongo (https://dashboard.paymongo.com → Developers). Use sk_test_ keys first.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,grab_pay
# Xendit (https://dashboard.xendit.co → Settings → API keys / Webhooks).
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# ---- Operations (secret) -------------------------------------------------------------
# Shared secret for the daily job endpoint (renewal reminders, expiry).
CRON_SECRET=
# Token water-level sensors send to POST /api/ingest/water-level.
SENSOR_INGEST_TOKEN=

# ---- Demo seeding (local scripts only) ------------------------------------------------
# Password applied to every *@demo.bahadvisory.test account by `npm run seed`.
DEMO_ACCOUNT_PASSWORD=
